# Bu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring.

# HolliHop: CRM manzili (masalan: markaz.t8s.ru) va API kalit (Sozlamalar → Integratsiya → API)
HH_DOMAIN=
HH_API_KEY=

# Telegram: @BotFather bergan token va kanal ID (python main.py chat-id bilan topiladi, -100... ko'rinishida)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = Telegramga yubormay, faqat ekranga chiqarish (sinov uchun)
DRY_RUN=0

# Jadval (O'zbekiston vaqti)
POLL_MINUTES=10
DIGEST_TIMES=12:00,17:00
DAILY_REPORT_TIME=18:00
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_TIME=17:00
ABSENCE_DEADLINE=20:00
LATE_LESSON_FROM=18:00

# Qoidalar
COURSE_MIN_DAYS=350
MAX_LESSONS_FOR_NEW_STUDENT=3
GROUP_TYPES=Group
